# JobPilot local development configuration
# Copy this file to .env and provide local values.
# Never commit .env or production credentials.

NODE_ENV=development

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobpilot?schema=public

# Ollama is optional until AI workflows are implemented.
OLLAMA_URL=http://localhost:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# Generate a unique secret with: openssl rand -base64 32
# Replace this local placeholder before starting application features that use it.
AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
