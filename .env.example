# Database
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5433/jobpilot


# Integration tests: must be a dedicated database whose name ends in _test
TEST_DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5433/jobpilot_test

# Auth
# Must match the dev server origin. `pnpm dev` pins port 3001 (3000 is often taken by Docker).
BETTER_AUTH_URL=http://localhost:3001
# Optional: extra trusted origins, comma-separated (BETTER_AUTH_URL is always trusted).
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# LLM Provider
LLM_PROVIDER=ollama  # ollama | demo
LLM_MODEL=llama3.2
EMBED_MODEL=bge-m3

# Ollama (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
