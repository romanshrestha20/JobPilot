        "job_analysis_failure_code_allowed": {
          "name": "job_analysis_failure_code_allowed",
          "value": "\"job_analysis\".\"failure_code\" IS NULL OR \"job_analysis\".\"failure_code\" IN ('provider_unavailable', 'model_unavailable', 'timeout', 'invalid_output', 'too_long', 'enqueue_failed', 'job_missing')"
