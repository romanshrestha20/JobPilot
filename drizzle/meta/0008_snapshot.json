          "value": "(\"job_analysis\".\"status\" = 'failed') = (\"job_analysis\".\"failure_code\" IS NOT NULL)"
        },
        "job_analysis_requirements_iff_completed": {
          "name": "job_analysis_requirements_iff_completed",
          "value": "(\"job_analysis\".\"status\" = 'completed') = (\"job_analysis\".\"requirements\" IS NOT NULL)"
        },
        "job_analysis_completed_has_provenance": {
          "name": "job_analysis_completed_has_provenance",
          "value": "\"job_analysis\".\"status\" <> 'completed' OR (\"job_analysis\".\"description_hash\" IS NOT NULL AND \"job_analysis\".\"prompt_version\" IS NOT NULL AND \"job_analysis\".\"provider\" IS NOT NULL AND \"job_analysis\".\"completed_at\" IS NOT NULL)"
        },
        "job_analysis_description_hash_format": {
          "name": "job_analysis_description_hash_format",
          "value": "\"job_analysis\".\"description_hash\" IS NULL OR \"job_analysis\".\"description_hash\" ~ '^[0-9a-f]{64}$'"
        },
        "job_analysis_requirements_object": {
          "name": "job_analysis_requirements_object",
          "value": "\"job_analysis\".\"requirements\" IS NULL OR (jsonb_typeof(\"job_analysis\".\"requirements\") = 'object' AND pg_column_size(\"job_analysis\".\"requirements\") <= 100000)"
        },
        "job_analysis_text_lengths": {
          "name": "job_analysis_text_lengths",
          "value": "(\"job_analysis\".\"prompt_version\" IS NULL OR char_length(\"job_analysis\".\"prompt_version\") BETWEEN 1 AND 50) AND (\"job_analysis\".\"model\" IS NULL OR char_length(\"job_analysis\".\"model\") BETWEEN 1 AND 200)"
        },
        "job_analysis_counters_non_negative": {
          "name": "job_analysis_counters_non_negative",
          "value": "\"job_analysis\".\"attempts\" >= 0 AND \"job_analysis\".\"dropped_ungrounded\" >= 0"
